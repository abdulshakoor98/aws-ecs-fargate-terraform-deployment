{
    "family": "aws-ecs-project-task",
    "taskRoleArn": "arn:aws:iam::286162616049:role/aws-ecs-project-ecs-task-role",
    "executionRoleArn": "arn:aws:iam::286162616049:role/aws-ecs-project-ecs-task-execution-role",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "aws-ecs-project-container",
            "image": "286162616049.dkr.ecr.ap-south-1.amazonaws.com/aws-ecs-project:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/aws-ecs-project",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ],
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}
